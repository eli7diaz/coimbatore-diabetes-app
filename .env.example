# Copy this file to `.env` and fill in the values.
#   cp .env.example .env
#
# `.env` is git-ignored. Never commit real keys.

# Hugging Face access token — powers meal photo identification.
# Create one at https://huggingface.co/settings/tokens (a "Read" token is enough).
# Server-side only: it is read by netlify/functions/analyze-meal.ts and never
# reaches the browser. Do NOT rename this to NEXT_PUBLIC_* — that would bundle
# the token into the client JS for every visitor.
HF_API_KEY=

# Firebase web config — used to store readings, meals, and insulin logs.
# From the Firebase console: Project settings > Your apps > SDK setup.
# These are NEXT_PUBLIC_* because Firebase web keys are public by design;
# access is controlled by Firestore security rules, not by hiding the key.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
